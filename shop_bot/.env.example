# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA...
# Ваш Telegram ID (узнать: написать @userinfobot). Несколько — через запятую.
ADMIN_IDS=123456789
# Название магазина в приветствии
SHOP_NAME=Сток Dinara Eurostock
# Пол по умолчанию, если в посте не указан (women / men). Пусто — не подставлять.
