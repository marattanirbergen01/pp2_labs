# Сколько постов показывать за раз
PAGE_SIZE=5
# (необязательно) ID каналов, которые читает бот, через запятую. Пусто — любой канал, где бот админ.
CHANNEL_IDS=

# Только для переноса старых постов (tools/forward_history.py), см. https://my.telegram.org
API_ID=
API_HASH=
